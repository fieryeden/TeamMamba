generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ───────────────────────────────────────

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider      String?
  aiModel         String?
  aiBaseUrl       String?
  aiApiKey        String?
  themePreference String?  @default("dark")
  locale          String?  @default("en")
  timezone        String?
  onboardingCompleted Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id                        String           @id @default(uuid())
  email                     String           @unique
  passwordHash              String
  twoFactorSecret           String?
  twoFactorEnabled          Boolean          @default(false)
  firstName                 String
  lastName                  String
  avatarUrl                 String?
  role                      UserRole         @default(MEMBER)
  status                    UserStatus       @default(ACTIVE)
  themePreference           ThemePreference  @default(SYSTEM)
  emailNotificationsEnabled Boolean          @default(true)
  emailOnMentions           Boolean          @default(true)
  emailOnAssignments        Boolean          @default(true)
  emailOnDueDates           Boolean          @default(true)
  onboardingCompleted       Boolean          @default(false)
  timezone                  String           @default("America/Los_Angeles")
  lastLoginAt               DateTime?
  settings                  UserSettings?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  // Relations
  ownedWorkspaces    Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  boardMemberships   BoardMember[]
  assignedItems      ItemAssignee[]
  comments           Comment[]
  activities         Activity[]
  automations        Automation[]
  notifications      Notification[]
  updates            Update[]
  apiTokens          ApiToken[]
  timeEntries        TimeEntry[]
  guestAccessTokens  GuestAccess[]
  dashboards         Dashboard[]
  docs               Doc[]             @relation("DocAuthor")
  auditLogs          AuditLog[]
  createdBoardViews  BoardView[]       @relation("BoardViewCreator")
  itemVersions       ItemVersion[]     @relation("ItemVersionUser")
  docEmbeds          DocEmbed[]        @relation("DocEmbedCreator")
  integrationConfigs IntegrationConfig[] @relation("IntegrationConfigCreator")
  pushSubscriptions  PushSubscription[]
  createdPolls       Poll[]             @relation("PollCreator")
  pollVotes          PollVote[]

  @@map("users")
}

model ApiToken {
  id        String   @id @default(uuid())
  userId    String
  name      String
  tokenHash String   @unique
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
  GUEST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

// ─── WORKSPACES & BOARDS ────────────────────────────────

model Workspace {
  id            String   @id @default(uuid())
  name          String
  description   String?
  icon          String?
  color         String?
  logoUrl       String?
  customDomain  String?  @unique
  dataRetentionPolicy Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  boards      Board[]
  docs        Doc[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Board {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  description String?
  icon        String?
  boardKind   BoardKind @default(KANBAN)
  color       String?
  isTemplate  Boolean   @default(false)
  autoArchiveDays  Int?
  retentionDays   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     BoardColumn[]
  groups      Group[]
  items       Item[]
  sprints     Sprint[]
  members     BoardMember[]
  automations Automation[]
  views       BoardView[]
  docEmbeds   DocEmbed[]
  activities  Activity[]
  guestAccess GuestAccess[]
  milestones  Milestone[]
  webhooks    Webhook[]
  connectLinks ConnectColumn[] @relation("ConnectTargetBoard")
  integrationConfigs IntegrationConfig[]
  columnPermissions ColumnPermission[]
  emailAddress BoardEmailAddress?

  auditLogs   AuditLog[]
  polls       Poll[]

  @@map("boards")
}

enum BoardKind {
  KANBAN
  TABLE
  TIMELINE
  CALENDAR
  GANTT
  FORM
  PRIVATE
}

model BoardMember {
  id      String    @id @default(uuid())
  boardId String
  userId  String
  role    BoardRole @default(MEMBER)
  board  Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@map("board_members")
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─── COLUMNS ────────────────────────────────────────────

model BoardColumn {
  id         String     @id @default(uuid())
  boardId    String
  title      String
  columnType ColumnType
  config     Json?
  order      Int
  width      Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  values     ColumnValue[]
  connectLinks ConnectColumn[]
  permissions ColumnPermission[]

  @@map("board_columns")
}

model ColumnPermission {
  id        String    @id @default(uuid())
  columnId  String
  boardId   String
  role      BoardRole
  canView   Boolean   @default(true)
  canEdit   Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  column    BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([columnId, role])
  @@map("column_permissions")
}

enum ColumnType {
  TEXT
  LONG_TEXT
  NUMBER
  STATUS
  DATE
  PEOPLE
  TAGS
  CHECKBOX
  TIMELINE
  LINK
  FILE
  FORMULA
  PROGRESS
  RATING
  EMAIL
  PHONE
  AUTO_NUMBER
  ITEM_ID
  CREATION_LOG
  LAST_UPDATE
  COLOR
  LOCATION
  WORLD_CLOCK
  HOUR
  DEPENDENCY
  VOTE
  TIME_TRACKING
  FORM_LINK
  MILESTONE
  CONNECT
  MIRROR
  ROLLUP
  STORY_POINTS
}

// ─── GROUPS & ITEMS ─────────────────────────────────────

model Group {
  id          String  @id @default(uuid())
  boardId     String
  name        String
  color       String  @default("#579bfc")
  position    Int
  isCollapsed Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  board       Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items       Item[]

  @@map("groups")
}

model Item {
  id         String   @id @default(uuid())
  boardId    String
  groupId    String
  name       String
  recurrenceRule String?
  color      String?
  icon       String?
  position   Int
  archivedAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  columnValues ColumnValue[]
  assignees  ItemAssignee[]
  comments   Comment[]
  activities Activity[]
  updates    Update[]
  subitems   Subitem[]
  timeEntries TimeEntry[]
  versions   ItemVersion[]
  docEmbeds  DocEmbed[]

  // Dependencies
  sprintItems    SprintItem[]
  dependenciesFrom Dependency[] @relation("DependencyFrom")
  dependenciesTo   Dependency[] @relation("DependencyTo")
  connectSourceLinks ConnectColumn[] @relation("ConnectSource")
  connectTargetLinks ConnectColumn[] @relation("ConnectTarget")
  polls            Poll[]

  @@map("items")
}

model Sprint {
  id          String        @id @default(uuid())
  boardId     String
  name        String
  goal        String?
  startDate   DateTime
  endDate     DateTime
  status      SprintStatus  @default(PLANNING)
  velocity    Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items       SprintItem[]
  @@map("sprints")
}

model SprintItem {
  id               String    @id @default(uuid())
  sprintId         String
  itemId           String
  storyPoints      Int?
  originalEstimate Int?
  burnedPoints     Int       @default(0)
  addedDuringSprint Boolean  @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sprint           Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([sprintId, itemId])
  @@map("sprint_items")
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

model BoardEmailAddress {
  id             String   @id @default(uuid())
  boardId         String   @unique
  address         String   @unique
  secret          String
  isEnabled       Boolean  @default(true)
  defaultGroupId  String?
  defaultStatus   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  board           Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("board_email_addresses")
}

model ConnectColumn {
  id            String     @id @default(uuid())
  columnId      String
  sourceItemId  String
  targetItemId  String
  targetBoardId String
  createdAt     DateTime   @default(now())
  column        BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  sourceItem    Item       @relation("ConnectSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItem    Item       @relation("ConnectTarget", fields: [targetItemId], references: [id], onDelete: Cascade)
  targetBoard   Board      @relation("ConnectTargetBoard", fields: [targetBoardId], references: [id], onDelete: Cascade)

  @@unique([columnId, sourceItemId, targetItemId])
  @@map("connect_columns")
}

model Subitem {
  id           String       @id @default(uuid())
  parentId     String
  name         String
  position     Int
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  parent       Item         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  columnValues ColumnValue[]

  @@map("subitems")
}

model Poll {
  id          String     @id @default(uuid())
  boardId     String
  itemId      String?
  creatorId   String
  question    String
  options     String[]
  isAnonymous Boolean    @default(false)
  isMultiSelect Boolean  @default(false)
  closesAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  item        Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creator     User       @relation("PollCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  votes       PollVote[]

  @@map("polls")
}

model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  userId    String
  optionIdx Int
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionIdx])
  @@map("poll_votes")
}

model ColumnValue {
  id        String      @id @default(uuid())
  itemId    String?
  subitemId String?
  columnId  String
  value     Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  item      Item?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  subitem   Subitem?    @relation(fields: [subitemId], references: [id], onDelete: Cascade)
  column    BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@map("column_values")
}

model ItemAssignee {
  id     String @id @default(uuid())
  itemId String
  userId String
  item   Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@map("item_assignees")
}

// ─── DEPENDENCIES ───────────────────────────────────────

model Dependency {
  id             String         @id @default(uuid())
  fromItemId     String
  toItemId       String
  dependencyType DependencyType @default(FINISH_TO_START)
  fromItem       Item           @relation("DependencyFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem         Item           @relation("DependencyTo", fields: [toItemId], references: [id], onDelete: Cascade)

  @@map("dependencies")
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

// ─── COMMENTS & UPDATES ─────────────────────────────────

model Comment {
  id        String          @id @default(uuid())
  itemId    String
  userId    String
  body      String
  parentId  String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  item      Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions CommentReaction[]

  @@map("comments")
}

model CommentReaction {
  id        String  @id @default(uuid())
  commentId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@map("comment_reactions")
}

model Update {
  id        String   @id @default(uuid())
  itemId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("updates")
}

// ─── ACTIVITY & NOTIFICATIONS ───────────────────────────

model Activity {
  id        String         @id @default(uuid())
  boardId   String
  itemId    String?
  userId    String
  action    ActivityAction
  details   Json?
  createdAt DateTime       @default(now())
  board     Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  item      Item?          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

enum ActivityAction {
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_DELETED
  ITEM_MOVED
  STATUS_CHANGED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  COMMENT_ADDED
  COLUMN_VALUE_CHANGED
  GROUP_CREATED
  GROUP_DELETED
  BOARD_CREATED
  BOARD_UPDATED
  AUTOMATION_TRIGGERED
  ITEM_MOVED_TO_BOARD
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String?
  type      NotificationType
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  STATUS_CHANGE
  DUE_DATE
  AUTOMATION
  SYSTEM
  BROADCAST
}

// ─── AUTOMATIONS ────────────────────────────────────────

model Automation {
  id          String            @id @default(uuid())
  boardId     String
  userId      String
  name        String
  trigger     AutomationTrigger
  conditions  Json?
  action      AutomationAction
  actionConfig Json?
  isEnabled   Boolean           @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  board       Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("automations")
}

enum AutomationTrigger {
  STATUS_CHANGED
  DATE_ARRIVES
  DATE_ARRIVED
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_MOVED_TO_GROUP
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  COLUMN_VALUE_CHANGED
  COLUMN_CHANGED
  RECURRING_SCHEDULE
}

enum AutomationAction {
  CHANGE_STATUS
  MOVE_ITEM_TO_GROUP
  SEND_NOTIFICATION
  NOTIFY_ASSIGNEE
  NOTIFY_USER
  SET_COLUMN_VALUE
  UPDATE_COLUMN
  CREATE_ITEM
  SEND_EMAIL
  ASSIGN_USER
  ADD_TAG
  SHIFT_DATE
  TRIGGER_INTEGRATION
}

// ─── VIEWS ──────────────────────────────────────────────

model BoardView {
  id        String    @id @default(uuid())
  boardId   String
  name      String
  filters   Json
  isDefault Boolean   @default(false)
  createdById String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy User      @relation("BoardViewCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("board_views")
}

model ItemVersion {
  id          String   @id @default(uuid())
  itemId       String
  field        String
  oldValue     String?
  newValue     String?
  changedById  String
  createdAt    DateTime @default(now())
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changedBy    User     @relation("ItemVersionUser", fields: [changedById], references: [id], onDelete: Cascade)

  @@map("item_versions")
}

// ─── TEMPLATES ──────────────────────────────────────────

model BoardTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?
  icon        String?
  config      Json
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("board_templates")
}

model TimeEntry {
  id             String   @id @default(uuid())
  itemId         String
  userId         String
  startTime      DateTime
  endTime        DateTime?
  durationSeconds Int     @default(0)
  isRunning      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

model GuestAccess {
  id          String    @id @default(uuid())
  boardId     String
  token       String    @unique
  createdById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("guest_access")
}

// ─── DASHBOARDS & WIDGETS ───────────────────────────────

model Dashboard {
  id          String    @id @default(uuid())
  name        String
  description String?
  ownerId     String
  shareToken  String?   @unique
  shareEnabled Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  widgets     Widget[]

  @@map("dashboards")
}

model Widget {
  id          String     @id @default(uuid())
  dashboardId String
  type        WidgetType
  title       String
  config      Json?
  order       Int        @default(0)
  width       Int        @default(1)
  height      Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dashboard   Dashboard  @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@map("widgets")
}

enum WidgetType {
  ITEM_COUNT
  STATUS_BREAKDOWN
  TIME_TRACKING_SUMMARY
  TEAM_WORKLOAD
  BURNDOWN
  NUMBER_SUMMARY
  RECENT_ACTIVITY
  CHART_BAR
  CHART_LINE
  CHART_PIE
  KANBAN
}

// ─── DOCS ───────────────────────────────────────────────

model Doc {
  id           String    @id @default(uuid())
  workspaceId  String
  title        String
  content      Json
  icon         String?
  createdById  String
  pinned       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation("DocAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  embeds       DocEmbed[]

  @@map("docs")
}

model DocEmbed {
  id          String   @id @default(uuid())
  docId       String
  boardId     String
  itemId      String?
  embedType   String
  embedData   Json
  createdById String
  createdAt   DateTime @default(now())
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  item        Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  createdBy   User     @relation("DocEmbedCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("doc_embeds")
}

// ─── MILESTONES ─────────────────────────────────────────

model Milestone {
  id          String    @id @default(uuid())
  boardId     String
  name        String
  description String?
  color       String    @default("#579bfc")
  targetDate  DateTime?
  achievedAt  DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  board       Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

// ─── WEBHOOKS ───────────────────────────────────────────

model Webhook {
  id          String   @id @default(uuid())
  boardId     String
  url         String
  secret      String   @default("")
  description String?
  events      String[] @default(["ITEM_CREATED", "ITEM_UPDATED", "ITEM_DELETED"])
  isEnabled   Boolean  @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  deliveries  WebhookEvent[]

  @@map("webhooks")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  webhookId   String
  eventType   String
  payload     Json?
  statusCode  Int      @default(0)
  success     Boolean  @default(false)
  response    String?
  createdAt   DateTime @default(now())
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_events")
}

// ─── AUDIT LOGS ─────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  boardId   String?
  itemId    String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model IntegrationConfig {
  id          String   @id @default(uuid())
  type        String
  config      Json
  enabled     Boolean  @default(true)
  createdById String
  boardId     String?
  createdAt   DateTime @default(now())
  createdBy   User     @relation("IntegrationConfigCreator", fields: [createdById], references: [id], onDelete: Cascade)
  board       Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  logs        IntegrationLog[]

  @@map("integration_configs")
}

model IntegrationLog {
  id            String            @id @default(uuid())
  integrationId String
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  action        String
  success       Boolean
  result        Json?
  createdAt     DateTime          @default(now())

  @@map("integration_logs")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}
